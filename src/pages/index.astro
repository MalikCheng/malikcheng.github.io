---
import Layout from '../layouts/Layout.astro';
import { notes } from '../data/notes';

const navItems = [
  { href: '#about', label: '关于' },
  { href: '#notes', label: '笔记' },
  { href: '#projects', label: '项目' },
  { href: '#contact', label: '联系' },
];

const projects = [
  {
    title: '技术面试知识库',
    description: '系统整理操作系统、网络、数据库、算法与系统设计等核心内容。',
    link: 'https://github.com/MalikCheng/CS-Notes',
    stats: '184k stars',
    tags: ['Interview', 'CS', 'Java'],
  },
  {
    title: 'Git 学习指南',
    description: '面向开发者的 Git 入门教程，覆盖常用命令和协作实践。',
    link: 'https://github.com/MalikCheng/learngit',
    stats: 'Guide',
    tags: ['Git', 'Workflow'],
  },
  {
    title: '剑指 Offer Java 实现',
    description: '经典面试题的 Java 实现与解题思路整理。',
    link: 'https://github.com/MalikCheng/coding-interviews',
    stats: 'Algorithms',
    tags: ['Java', 'LeetCode'],
  },
];

const skills = ['Java', 'Go', 'Spring Boot', 'Redis', 'Kafka', 'MySQL', 'Docker', 'System Design'];
---

<Layout title="Malik Cheng - 后端开发工程师">
  <header class="site-header">
    <a href="#" class="brand" aria-label="Malik Cheng home">
      <span class="brand-mark">M</span>
      <span>Malik Cheng</span>
    </a>
    <nav class="nav" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Backend Engineer · Java / Go · Baidu</p>
        <h1 id="hero-title">写可靠系统，也写清楚为什么。</h1>
        <p class="hero-intro">
          我是 Malik Cheng，专注高并发服务、分布式系统和工程知识整理。这里收集我对后端开发、面试方法和长期学习的笔记。
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#notes">阅读笔记</a>
          <a class="button button-secondary" href="https://github.com/MalikCheng" target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </div>

      <aside class="field-card" aria-label="Profile summary">
        <div class="field-card-top">
          <span class="status-dot"></span>
          <span>Engineering Journal</span>
        </div>
        <div class="diagram" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>
        <dl class="metrics">
          <div>
            <dt>Focus</dt>
            <dd>Distributed Systems</dd>
          </div>
          <div>
            <dt>Stack</dt>
            <dd>Java · Go</dd>
          </div>
          <div>
            <dt>Open Source</dt>
            <dd>CS Notes</dd>
          </div>
        </dl>
      </aside>
    </section>

    <section id="about" class="section split-section">
      <div>
        <p class="section-kicker">About</p>
        <h2>工程问题，最后都要回到边界和取舍。</h2>
      </div>
      <div class="prose-block">
        <p>
          我在百度从事后端开发，主要使用 Java 和 Go 构建服务。日常关注系统稳定性、性能优化、数据链路和团队协作中的工程决策。
        </p>
        <p>
          这个博客不会追求热闹的技术姿态，而是记录可以复用的判断：一个设计为什么成立，一个问题怎么定位，一个知识点如何讲明白。
        </p>
      </div>
    </section>

    <section id="notes" class="section">
      <div class="section-heading">
        <p class="section-kicker">Notes</p>
        <h2>近期想写的主题</h2>
      </div>
      <div class="note-list">
        {notes.map((note, index) => (
          <a class="note-item" href={`/notes/${note.slug}/`}>
            <span class="note-index">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <p class="note-meta">{note.meta}</p>
              <h3>{note.title}</h3>
              <p>{note.summary}</p>
            </div>
            <span class="note-arrow" aria-hidden="true">阅读</span>
          </a>
        ))}
      </div>
    </section>

    <section id="projects" class="section">
      <div class="section-heading">
        <p class="section-kicker">Projects</p>
        <h2>公开项目</h2>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <a class="project-card" href={project.link} target="_blank" rel="noreferrer">
            <div class="project-card-head">
              <h3>{project.title}</h3>
              <span>{project.stats}</span>
            </div>
            <p>{project.description}</p>
            <div class="tag-row">
              {project.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section skill-strip" aria-label="Technical skills">
      {skills.map((skill) => (
        <span>{skill}</span>
      ))}
    </section>

    <section id="contact" class="section contact-section">
      <div>
        <p class="section-kicker">Contact</p>
        <h2>有值得认真聊的工程问题，欢迎来找我。</h2>
      </div>
      <div class="contact-links">
        <a href="https://github.com/MalikCheng" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://x.com/cheng_mali59438" target="_blank" rel="noreferrer">X / Twitter</a>
        <a href="mailto:malik@example.com">Email</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <span>© 2026 Malik Cheng</span>
    <span>Built with Astro</span>
  </footer>
</Layout>
